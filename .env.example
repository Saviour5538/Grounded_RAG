LLM_PROVIDER=gemini

GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=1024

# ── [REQUIRED] Vector DB (Qdrant) ─────────────────────────────────────────────
#
#  QDRANT_MODE=local  → no Docker needed, data stored in QDRANT_LOCAL_PATH
#  QDRANT_MODE=server → connects to a running Qdrant container at QDRANT_URL
#
# ── [REQUIRED] Vector store ──────────────────────────────────────────────────
#  "pinecone" → Pinecone Serverless (free forever, recommended)
#  "qdrant"   → local file mode or self-hosted Qdrant
VECTOR_STORE=pinecone

# ── Pinecone (used when VECTOR_STORE=pinecone) ────────────────────────────────
#  Sign up free at https://app.pinecone.io → create a Serverless index
#  Cloud/region must match when creating the index for the first time.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=grounded-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Qdrant (used when VECTOR_STORE=qdrant) ───────────────────────────────────
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=grounded_rag

# ── [REQUIRED to index] Embeddings ────────────────────────────────────────────
#
#  EMBEDDING_PROVIDER=local  → uses sentence-transformers, no API key needed.
#                               Model downloads automatically on first run (~90 MB).
#  EMBEDDING_PROVIDER=openai → uses OpenAI API, needs OPENAI_API_KEY above.
#
#  If you change the model you MUST also update EMBEDDING_DIM:
#    BAAI/bge-small-en-v1.5  → 384   (fast, good quality, recommended to start)
#    BAAI/bge-m3             → 1024  (better recall, Phase 3+ upgrade)
#    text-embedding-3-small  → 1536  (OpenAI, if you prefer cloud embeddings)
#
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=3072

# ── [OPTIONAL] Chunking ───────────────────────────────────────────────────────
#  Safe to leave as defaults until Phase 3 eval shows a reason to tune.
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── [OPTIONAL] Retrieval ──────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RERANKER_TOP_N=5

# ── [OPTIONAL] Confidence / Abstention ───────────────────────────────────────
#  Lower = more willing to answer (risk: hallucination)
#  Higher = more abstentions on uncertain questions (Phase 5 tunes this)
CONFIDENCE_THRESHOLD=0.3

# ── [OPTIONAL] Cache (Phase 7) ───────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_MAX_SIZE=512

# ── [OPTIONAL] Observability (Phase 7) ───────────────────────────────────────
TRACE_LOG_PATH=logs/traces.jsonl
#  Set Langfuse keys to get a real-time dashboard at cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── [OPTIONAL] Agentic re-retrieval (Phase 8) ─────────────────────────────────
#  When confidence < threshold, the pipeline reformulates the query and retries
#  up to AGENTIC_MAX_RETRIES times before returning "Insufficient evidence found."
AGENTIC_RETRY_ENABLED=true
AGENTIC_MAX_RETRIES=2
